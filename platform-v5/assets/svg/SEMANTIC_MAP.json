  "voice": {
    "pace":        "icon-timer",
    "pitch":       "icon-sliders-horizontal",
    "volume":      "icon-volume-2",
    "tone":        "icon-thermometer",
    "pause":       "icon-pause"
  },

  "empathy": {
    "acknowledge": "icon-ear",
    "validate":    "icon-heart",
    "refocus":     "icon-compass",
    "action":      "icon-zap"
  }
}
